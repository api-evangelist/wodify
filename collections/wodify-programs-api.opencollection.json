{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wodify Classes Programs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Programs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get programs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wodify.com/v1/programs",
            "params": [
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Specifies the order in which the list will be returned."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Specifies the page of records to be returned. Defaults to 1."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of records to return per page. Maximum and default are 100."
              }
            ]
          },
          "docs": "Returns the training programs offered by the gym."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wodify Classes Reference API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wodify.com/v1/locations"
          },
          "docs": "Returns the gym locations configured in the account."
        },
        {
          "info": {
            "name": "Get employees",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wodify.com/v1/employees"
          },
          "docs": "Returns the staff/employees configured in the account."
        }
      ]
    }
  ],
  "bundled": true
}
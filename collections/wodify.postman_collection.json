{
  "info": {
    "name": "Wodify API",
    "description": "REST API for the Wodify gym, fitness, and CrossFit box management platform. Base URL: https://api.wodify.com/v1. Every request is authenticated with an x-api-key header (Wodify Core > Digital Presence > Web Integrations > API Keys, or the Wodify Developer Portal for partners). Paths and query parameters for clients, classes, workouts, programs, and services were verified against the live reference; other collections are modeled from Wodify's documented REST operation catalog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.wodify.com/v1", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Get clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/clients?page=1&page_size=100", "host": ["{{baseUrl}}"], "path": ["clients"], "query": [{ "key": "page", "value": "1" }, { "key": "page_size", "value": "100" }] },
            "description": "Returns a paged list of clients (members)."
          }
        },
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"\",\n  \"last_name\": \"\",\n  \"email\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] },
            "description": "Creates a new client record."
          }
        },
        {
          "name": "Get client",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/clients/:id", "host": ["{{baseUrl}}"], "path": ["clients", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Retrieves a single client by ID."
          }
        },
        {
          "name": "Update client",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/clients/:id", "host": ["{{baseUrl}}"], "path": ["clients", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "description": "Updates an existing client."
          }
        },
        {
          "name": "Search clients",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/clients/search", "host": ["{{baseUrl}}"], "path": ["clients", "search"] },
            "description": "Searches clients using a filter payload."
          }
        }
      ]
    },
    {
